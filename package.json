{
  "name": "magento",
  "version": "1.0.0",
  "private": true,
  "description": "Address Zen Magento Extension",
  "type": "module",
  "author": {
    "name": "Address Zen",
    "email": "support@addresszen.com",
    "url": "https://addresszen.com/"
  },
  "bugs": {
    "url": "https://github.com/addresszen/magento/issues",
    "email": "support@addresszen.com"
  },
  "homepage": "https://github.com/addresszen/magento",
  "repository": {
    "type": "git",
    "url": "https://github.com/addresszen/magento.git"
  },
  "scripts": {
    "semantic-release": "semantic-release",
    "start": "make bootstrap && make set-base-url",
    "build": "NODE_ENV=production rollup -c",
    "watch": "rollup -cw",
    "lint": "eslint lib/**/*.ts",
    "lint-fix": "eslint lib/**/*.ts --fix",
    "test:e2e": "playwright test --config test/e2e/playwright.config.ts",
    "test:snapshot": "playwright test --config test/snapshot/playwright.config.ts",
    "test:build": "rollup -c test/snapshot/rollup.config.js",
    "test:watch": "rollup -c test/snapshot/rollup.config.js -w",
    "test": "npm run test:snapshot"
  },
  "release": {
    "branches": ["main"],
    "tagFormat": "${version}",
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      ["@semantic-release/changelog", { "changelogFile": "CHANGELOG.md" }],
      ["@semantic-release/git", {
        "assets": ["CHANGELOG.md", "composer.json"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }],
      "@semantic-release/github"
    ]
  },
  "license": "MIT",
  "overrides": {
    "@ideal-postcodes/address-finder": {
      "@ideal-postcodes/jsutil": "~7.4.3"
    }
  },
  "dependencies": {
    "@ideal-postcodes/address-finder": "~5.2.6"
  },
  "devDependencies": {
    "@babel/preset-env": "~7.16.11",
    "@cablanchard/eslint-config": "~2.1.1",
    "@cablanchard/tsconfig": "~2.0.0",
    "@ideal-postcodes/api-fixtures": "~1.2.0",
    "@ideal-postcodes/api-typings": "~2.1.0",
    "@ideal-postcodes/jsutil": "~4.6.0",
    "@playwright/test": "~1.52.0",
    "@prettier/plugin-php": "~0.18.4",
    "@prettier/plugin-xml": "~0.13.1",
    "@rollup/plugin-commonjs": "~21.0.2",
    "@rollup/plugin-json": "~4.1.0",
    "@rollup/plugin-node-resolve": "~13.2.0",
    "@semantic-release/changelog": "~6.0.3",
    "@semantic-release/git": "~10.0.1",
    "@semantic-release/github": "~11.0.0",
    "@types/babel__traverse": "~7.18.3",
    "@types/node": "~14.14.41",
    "@typescript-eslint/eslint-plugin": "~5.17.0",
    "@typescript-eslint/parser": "~5.19.0",
    "@wessberg/rollup-plugin-ts": "~1.3.14",
    "cypress": "~14.2.1",
    "eslint": "~7.32.0",
    "http-server": "~14.1.1",
    "prettier": "~2.2.1",
    "process": "~0.11.10",
    "rollup": "~2.70.1",
    "rollup-plugin-terser": "~7.0.2",
    "semantic-release": "~24.2.0",
    "typescript": "~4.2.4"
  }
}

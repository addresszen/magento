<?php
/**
 * Address Zen - Frontend Configuration
 *
 * Universal template that works with all themes (Luma, Hyvä, custom).
 * Uses external script loading for CSP compliance.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Addresszen\Lookup\ViewModel\StoreConfig $viewModel
 */
$viewModel = $block->getData('view_model');

if (!$viewModel->isEnabled()) {
    return;
}

$config = $viewModel->getJsonConfig();
$bindingUrl = $block->getViewFileUrl('Addresszen_Lookup::binding.min.js');
$loaderUrl = $block->getViewFileUrl('Addresszen_Lookup::js/loader.js');
?>
<div id="addresszen-config" 
     data-config="<?= $escaper->escapeHtmlAttr($config) ?>"
     data-binding-url="<?= $escaper->escapeHtmlAttr($bindingUrl) ?>"
     style="display:none;"></div>
<script src="<?= $escaper->escapeHtmlAttr($loaderUrl) ?>"></script>
